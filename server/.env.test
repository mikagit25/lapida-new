# Тестовые переменные окружения
NODE_ENV=test
PORT=10001

# MongoDB для тестов (используйте отдельную тестовую БД!)
MONGODB_URI=mongodb://localhost:27017/lapida_test_db

# JWT Secret для тестов
JWT_SECRET=test_jwt_secret_for_testing_only_do_not_use_in_production
SESSION_SECRET=test_session_secret_for_testing_only

# Redis для тестов (опционально, можно использовать отдельную БД)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Отключаем некоторые security фичи для тестов
DISABLE_RATE_LIMITING=true
